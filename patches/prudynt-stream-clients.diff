+// Last HTTP client of a stream out: stop its worker so it idles instead of
+// producing into queues that nothing consumes - unless an RTSP session still
+// plays it.  The check after the store covers an RTSP PLAY that came in
+// between (it counts itself before it sets hasDataCallback).
+template <typename Stream> static void release_http_client(Stream &st) {
+  if (st.http_clients.fetch_sub(1) > 1)
+    return; // other HTTP clients still attached
+  st.http_clients.store(0);
+  if (st.rtsp_players.load() > 0)
+    return; // an RTSP session still needs the frames
+  st.hasDataCallback.store(false, std::memory_order_relaxed);
+  if (st.rtsp_players.load() > 0) {
+    st.hasDataCallback.store(true, std::memory_order_relaxed);
+    st.should_grab_frames.notify_one();
+  }
+}
 
