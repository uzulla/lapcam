 // -- Close ------------------------------------------------------------------
 
+// Publish this server's player count of a stream (see globals.hpp:
+// rtsp_players).  At zero the worker is stopped, unless an HTTP fMP4 client
+// (/chN.mp4) still reads the stream; the check after the store covers a
+// client that attached in between (it counts itself before it sets
+// hasDataCallback).
+template <typename Stream>
+static void rtspPlayersChanged(Stream &st, int players) {
+    st.rtsp_players.store(players);
+    if (players > 0 || st.http_clients.load() > 0) return;
+    st.hasDataCallback.store(false, std::memory_order_relaxed);
+    if (st.http_clients.load() > 0) {
+        st.hasDataCallback.store(true, std::memory_order_relaxed);
+        st.should_grab_frames.notify_one();
+    }
+}
